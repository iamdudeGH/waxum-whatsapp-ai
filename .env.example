# Database Configuration
# Supports: PostgreSQL, MySQL, SQLite
# Examples:
#   DATABASE_URL=postgres://user:password@localhost:5432/wagateway
#   DATABASE_URL=mysql://user:password@localhost:3306/wagateway
#   DATABASE_URL=sqlite://waxum.db
# DATABASE_URL=postgres://user:password@localhost:5432/wagateway

# Legacy PostgreSQL config (used as fallback if DATABASE_URL is not set)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=wagateway

# JWT Configuration
# JWT_SECRET=change-me-in-production

# WhatsApp Session Storage
WHATSAPP_STORAGE_PATH=./whatsapp_sessions

# Public base URL for this instance, used only to fix the "servers" entry
# in the Swagger/OpenAPI doc when running behind a reverse proxy — without
# it, Swagger UI's "Try it out" always targets http://localhost:3451.
# PUBLIC_BASE_URL=https://waxum.example.com

# Auto-reject every incoming call instead of registering it for manual
# POST .../calls/reject (default false — calls sit in the registry until
# you accept/reject/ring them, or your webhook consumer does).
# AUTO_REJECT_INCOMING_CALLS=true

# Simulate a composing ("typing…") indicator immediately before every
# message/media send, instead of requiring a separate chatstate/typing
# call first (default false, best-effort — a failed presence send never
# blocks the actual message).
# AUTO_PRESENCE_ON_SEND=true

# How long the composing indicator is held before the message goes out, in
# milliseconds (default 1200, capped at 10000). 0 restores the previous
# send-immediately behaviour. Only applies when AUTO_PRESENCE_ON_SEND=true.
# AUTO_PRESENCE_DELAY_MS=1200

# S3-compatible object storage for call recordings (optional — omit
# S3_BUCKET to keep recordings on local disk under WHATSAPP_STORAGE_PATH).
# Works against real AWS S3, MinIO, Cloudflare R2, Wasabi, etc.
# S3_BUCKET=waxum-recordings
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Local whisper.cpp-compatible transcription server (optional — omit
# WHISPER_API_URL to disable POST /calls/*/transcript). Point at the
# whisper.cpp `server` example's /inference endpoint, or any compatible
# server run as its own service — never compiled into the waxum binary.
# WHISPER_API_URL=http://localhost:8081/inference

# NATS JetStream (optional — omit NATS_URL to disable)
NATS_URL=nats://localhost:4222
NATS_EVENTS_STREAM=WA_EVENTS
NATS_SEND_STREAM=WA_SEND
NATS_EVENTS_MAX_AGE_DAYS=7
NATS_SEND_MAX_AGE_DAYS=1
# NATS_TOKEN=
# NATS_CREDS_FILE=

# Scheduled send dispatcher (optional)
# Poll interval in milliseconds for the background task that dispatches
# due scheduled messages (default 1000).
# SCHEDULER_POLL_MS=1000

# Blast (bulk-send) worker (optional)
# Poll interval in milliseconds for the background task that claims and
# drains blast jobs (default 1000).
# BLAST_POLL_MS=1000

# Message history / full-text search (optional)
# Best-effort ingestion of incoming + outgoing message text into the
# messages table powering GET .../messages/search. Set to false to
# disable ingestion (existing rows stay searchable).
# MESSAGE_HISTORY_ENABLED=true

# Per-peer-IP rate limit on the whole API. Off by default -- keyed on
# the TCP peer address, so behind a reverse proxy every client behind
# it shares one quota (see #83). Set RATE_LIMIT_ENABLED=true to turn it
# on, then tune the other two if the defaults don't fit.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_SECOND=60
# RATE_LIMIT_BURST=150

# Logging
RUST_LOG=waxum=info,tower_http=info

# ---------------------------------------------------------------
# AI bot worker (bot/*.py). Load before running:  set -a; . ./.env; set +a
# ---------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
WAXUM_URL=http://127.0.0.1:3451
WAXUM_SESSION=main
WAXUM_TOKEN_FILE=./superadmin.token
GROQ_MODEL=qwen/qwen3.8-27b
MAX_TOKENS=160
CHAT_HISTORY=4
POLL_SECS=0.4
# Comma-separated numbers (country code, digits only) that get a more polite tone
RESPECTFUL_NUMBERS=
# Speech-to-text / text-to-speech
STT_MODEL=whisper-large-v3
STT_LANG=hi
TTS_VOICE=en-IN-PrabhatNeural
# Experimental live-call agent (bot/voice_agent.py) only
# TTS_RATE=-5%
# EDGE_TTS_BIN=edge-tts
# ECHO_TAIL_S=0.8
# BARGE_RMS=2200
# BARGE_GRACE_S=1.5
# BARGE_FRAMES=4
# ANSWER_GRACE_S=7
# SPEECH_RMS=300
# END_SILENCE_MS=800
# MIN_SPEECH_MS=400
# MAX_SPEECH_MS=7000
